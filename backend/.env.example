# Supabase Transaction Pooler connection string (Port 6543) - For running app
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Session/Direct connection string (Port 5432) - For migrations only
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase API credentials
SUPABASE_URL=https://<project-ref>.supabase.co

# Authentication & Server configuration
JWT_SECRET=<placeholder-jwt-secret>
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.vercel.app
NODE_ENV=development
PORT=5000
SEED_ADMIN_PASSWORD=your-secure-admin-password

# Bakong KHQR (manual confirmation: QR is generated, an admin marks it paid)
BAKONG_ACCOUNT_ID=abaakhppxxx@abaa
BAKONG_MERCHANT_NAME=SPMS Store
BAKONG_MERCHANT_CITY=Phnom Penh
