# LOCAL DEVELOPMENT ONLY.
# Production / Supabase connection strings belong ONLY in the Render environment
# variables (or your host's secret store) - never in this file and never in git.
# This example is for `npm run dev` against the local Docker dev DB.

# The port below is DEV_DB_PORT (default 15433). It is written literally because
# plain dotenv does not expand ${...}; keep it in sync with DEV_DB_PORT here and
# with docker-compose.dev.yml / backend/scripts/_guard.js.
DATABASE_URL=postgresql://<dev-user>:<dev-password>@127.0.0.1:15433/spms_dev
DEV_DB_PORT=15433

# Local dev-only values. Generate your own; never reuse production secrets.
JWT_SECRET=<placeholder-jwt-secret-dev>
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development
PORT=5000
ADMIN_SECRET=<placeholder-local-seed-secret>

# Bakong KHQR (manual confirmation: QR is generated, an admin marks it paid)
BAKONG_ACCOUNT_ID=abaakhppxxx@abaa
BAKONG_MERCHANT_NAME=SPMS Store
BAKONG_MERCHANT_CITY=Phnom Penh
