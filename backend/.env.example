# LOCAL DEVELOPMENT - native PostgreSQL on Windows (no Docker required).
# Copy this file to backend/.env and replace the placeholders.
# backend/.env is git-ignored; never commit a real password or connection string.

# --- Local dev database -----------------------------------------------------
# One-time provisioning: run database/local/001_app_role.sql as postgres,
# then put the same password in DATABASE_URL. The app connects as spms_app,
# never as the postgres superuser.
DEV_DB_MODE=local
DEV_DB_PORT=5432
DEV_DB_NAME=spms_db
DATABASE_URL=postgresql://spms_app:<local-app-password>@127.0.0.1:5432/spms_db

# Browser origin(s) allowed to call the API (comma-separated, exact match).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173

NODE_ENV=development
PORT=5000

# Generate a local-only value; never reuse a production secret.
JWT_SECRET=<placeholder-local-jwt-secret>

# Optional: raise/lower the backend pool (1-50, default 10).
# DB_POOL_MAX=10

# --- Disposable test database (Docker, only for verify/e2e) ------------------
# `npm run verify` and `npm run test:e2e` start/use this loopback container.
# They never use the native dev database above.
TEST_DB_PORT=15432

# --- Bakong KHQR (manual confirmation) --------------------------------------
BAKONG_ACCOUNT_ID=abaakhppxxx@abaa
BAKONG_MERCHANT_NAME=SPMS Store
BAKONG_MERCHANT_CITY=Phnom Penh

# --- Production (set these in the Render secret store, not here) -------------
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# NODE_ENV=production
# CORS_ORIGINS=https://<frontend-host>
# DB_SSL_CA=<optional path or PEM text when the host uses a private CA>
