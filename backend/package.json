{
  "name": "spms-backend",
  "version": "1.0.0",
  "description": "SPMS - Sale & Product Management System Backend API",
  "main": "src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node scripts/dev-db.js seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "verify": "node scripts/verify.js",
    "verify:full": "npm run verify && powershell -ExecutionPolicy Bypass -File ./scripts/run-mutants.ps1",
    "flake": "node scripts/flake.js",
    "floor-tests": 102,
    "floor-suites": 15
  },
  "dependencies": {
    "bakong-khqr": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "memory-cache": "^0.2.0",
    "morgan": "^1.11.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "axios": "1.21.1"
  }
}
