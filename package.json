{
  "name": "spms-app",
  "version": "1.0.0",
  "description": "SPMS - Sale & Product Management System",
  "private": true,
  "scripts": {
    "dev": "node backend/scripts/dev.js",
    "db:dev:preflight": "node backend/scripts/dev-db.js preflight",
    "db:dev:up": "node backend/scripts/dev-db.js up",
    "db:dev:migrate": "node backend/scripts/dev-db.js migrate",
    "db:dev:seed": "node backend/scripts/dev-db.js seed",
    "db:reset:local": "node backend/scripts/reset-local.js",
    "smoke:local": "node backend/scripts/smoke-local.js",
    "verify": "node backend/scripts/verify.js",
    "db:deploy": "powershell -ExecutionPolicy Bypass -File ./backend/scripts/deploy-db.ps1 -Target live",
    "db:deploy:dry": "powershell -ExecutionPolicy Bypass -File ./backend/scripts/deploy-db.ps1 -Target local -DryRun",
    "verify:full": "node backend/scripts/verify-full.js",
    "test:e2e": "playwright test",
    "ui:shots": "node backend/scripts/ui-shots.js",
    "rehearse": "node backend/scripts/rehearse.js",
    "names:diff": "node backend/scripts/names-diff.js",
    "names:accept": "node backend/scripts/names-accept.js",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "cd backend && npm start",
    "build": "cd frontend && npm run build",
    "vercel-build": "cd frontend && npm install && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "concurrently": "^8.0.1"
  }
}
